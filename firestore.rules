rules_version = '2';

// Each signed-in user can read and write only their own documents.
// Anything not matched below is denied (Firestore denies by default).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profile: displayName, email, lastLogin, profileImage, uid
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Daily log: foodEntries/{uid}/entries/{yyyy-mm-dd}
    match /foodEntries/{uid}/{rest=**} {
      allow read, write: if isOwner(uid);
    }

    // Saved foods: savedOxalates/{uid}/oxalates/{id}
    match /savedOxalates/{uid}/{rest=**} {
      allow read, write: if isOwner(uid);
    }
  }
}
